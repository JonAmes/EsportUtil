<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 = dev/Linux build; net8.0-windows10.0.19041.0 = Windows build with WinRT toast projection -->
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <RollForward>LatestMajor</RollForward>  <!-- dev boxes may only have a newer shared runtime -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>  <!-- lets the Linux dev box compile the Windows TFM -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>esportsutil</AssemblyName>
    <!-- Release version = the git tag (v0.5.0 -> 0.5.0). The GitHub release workflow and the
         agent's self-update compare on this; bump per release (or CI passes -p:Version=). -->
    <Version>0.5.5</Version>
    <RootNamespace>EsportsUtil</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Resource budget: workstation GC, no concurrent background GC churn (PLAN.md) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>  <!-- locate overlay surface (transient window, no steady cost) -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="esportsutil-tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <!-- Windows service host (ServiceBase) + ServiceController for start/stop/status: Windows TFM only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
